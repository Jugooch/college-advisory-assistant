# Example environment for local development.
# Copy to the repository root as .env:  cp infra/env.example .env
# Nothing loads .env automatically: `pnpm dev` reads process.env, so export the values into your
# shell first, for example:  set -a && . ./.env && set +a && pnpm dev
# Synthetic data only; never real student records locally. Never commit real secrets.
# This file lives outside the .env* pattern so agents can read and maintain it (ADR-0003).

# --- Shared (api and worker) ---------------------------------------------------------------
# development | test | production. Defaults to development.
NODE_ENV=development
# Required by both the API and the worker; matches infra/docker-compose.yml.
DATABASE_URL=postgres://caa:caa@localhost:5432/caa

# --- api (apps/api/src/config/env.ts) --------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
# none | dev. Defaults to none, which denies every protected request until SSO is added.
# dev is refused at startup when NODE_ENV=production.
AUTH_MODE=dev
# JSON object: opaque bearer token -> synthetic SSO identity {issuer, subject} it signs in as.
# Only read when AUTH_MODE=dev. Defaults to {}. Keep it on one line and single-quoted.
DEV_AUTH_TOKENS='{"dev-token-admin":{"issuer":"https://idp.synthetic.example","subject":"synthetic-admin-001"},"dev-token-advisor":{"issuer":"https://idp.synthetic.example","subject":"synthetic-advisor-001"},"dev-token-student":{"issuer":"https://idp.synthetic.example","subject":"synthetic-student-001"}}'
# Max record <-> audit skew in ms. Defaults to 3600000 (1 hour); max 7 days; checked at startup.
AUDIT_RECORD_MAX_SKEW_MS=3600000
# Max pinned record/audit age in ms for course checks. 0-7 days; required in production, else 24 h.
ACADEMIC_SOURCE_MAX_AGE_MS=86400000
# Active ruleset version the API verifies against. Required when NODE_ENV=production.
ACTIVE_RULESET_VERSION=demo-2026.1
# Max attempts to add a bundle per schedule-solver request. Whole number 1-3000000; optional,
# defaults to 3000000 (ADR-0010 §1).
SCHEDULE_SOLVER_WORK_CAP=3000000

# --- worker (apps/worker/src/shared/worker-env.ts) -------------------------------------------
# Largest share of invalid rows, in whole percent 0-100, a roster batch may have and still
# publish its valid rows; above it the whole batch is quarantined. Defaults to 5.
ROSTER_MAX_INVALID_ROW_PERCENT=5
