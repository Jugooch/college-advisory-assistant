{
  "name": "@caa/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL tables, row mappers, and repositories. The only package that talks to the database.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed/run-seed.ts"
  },
  "dependencies": {
    "@caa/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino": "^10.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  }
}
